{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelscope.cn/schemas/studio-verification-1.0.json",
  "title": "ModelScope Studio post-deployment verification",
  "type": "object",
  "required": ["schema_version", "record_type", "verification", "runtime", "measurements", "checks", "condition_results", "remaining_external_calls", "issues", "result", "secrets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "studio_verification"},
    "verification": {
      "type": "object",
      "required": ["id", "assessment_id", "created_at", "status", "studio_url", "deployed_revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "assessment_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "status": {"enum": ["running", "passed", "failed", "partial"]},
        "studio_url": {"type": "string", "minLength": 1},
        "deployed_revision": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["declared_sku", "gpu_name", "compute_capability", "visible_vram_gib", "python_version", "torch_version", "cuda_version", "persistent_workspace"]
    },
    "measurements": {
      "type": "object",
      "required": ["first_startup_seconds", "cached_startup_seconds", "peak_vram_gib", "inference_seconds", "workload_envelope", "cache_hit"],
      "properties": {
        "workload_envelope": {"enum": ["minimum", "recommended", "maximum"]}
      }
    },
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "condition_results": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "remaining_external_calls": {"type": "array", "items": {"type": "object"}},
    "issues": {"type": "array", "items": {"type": "object"}},
    "result": {
      "type": "object",
      "required": ["status", "summary", "verified_at"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed", "partial"]},
        "summary": {"type": "string"},
        "verified_at": {"type": ["string", "null"]}
      }
    },
    "secrets": {"type": "array", "items": {"$ref": "#/$defs/secret"}}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "description", "status", "evidence", "success_criteria"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "passed", "failed", "not_applicable"]},
        "evidence": {"type": "string"},
        "success_criteria": {"type": "string", "minLength": 1}
      }
    },
    "secret": {
      "type": "object",
      "required": ["name", "purpose", "required_at"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "required_at": {"enum": ["build", "startup", "runtime"]}
      }
    }
  }
}
